{
  "name": "life-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A deterministic generational life simulation, and the web application built on it.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "check": "npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
