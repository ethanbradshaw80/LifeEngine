# ---------------------------------------------------------------
# The Life Engine — .gitignore
#
# Deliberately NOT ignored: docs/, .claude/agents/, tests, ADRs.
# Those are project assets and must be version-controlled.
# ---------------------------------------------------------------

# Dependencies
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# Build output
dist/
build/
out/
.vite/
*.tsbuildinfo

# Test and coverage output
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/

# Simulation runtime output — regenerable, and can grow very large.
# Determinism means any run can be reproduced from its seed, so raw
# output never needs to be committed.
runs/
profiles/
benchmarks/results/
*.savegame
*.simlog

# ---------------------------------------------------------------
# SECRETS — nothing of this shape may ever be committed.
# Becomes critical at Milestone 6 when accounts arrive.
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
.dev.vars

# Local-only developer overrides
*.local.json
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS noise
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Claude Code local session state (agent definitions ARE tracked)
.claude/settings.local.json
